                                <TextBox Text="{Binding Shops[4].Bank1, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F2}}" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                <TextBlock Text="Банк 2" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"  TextAlignment="Center"/>
                                <TextBox Text="{Binding Shops[4].Bank2,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F2}}" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                <TextBlock Text="QR код1" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center"  TextAlignment="Center"/>
                                <TextBox Text="{Binding Shops[4].QRcode1,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F2}}" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                <TextBlock Text="QR код2" Grid.Row="5" HorizontalAlignment="Center" VerticalAlignment="Center"  TextAlignment="Center"/>
                                <TextBox Text="{Binding Shops[4].QRcode2,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F2}}" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                <TextBlock Text="СБП" Grid.Row="6" HorizontalAlignment="Center" VerticalAlignment="Center"  TextAlignment="Center"/>
                                <TextBox Text="{Binding Shops[4].SBP,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F2}}" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                <TextBlock Text="ЗП" Grid.Row="7" HorizontalAlignment="Center" VerticalAlignment="Center"  TextAlignment="Center"/>
                                <TextBox Text="{Binding Shops[4].ZP,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F2}}" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                <TextBlock Text="Общая сумма" Grid.Row="8" HorizontalAlignment="Center" VerticalAlignment="Center"  TextAlignment="Center"/>
                                <TextBox Text="{Binding Shops[4].TotalAmountExpenditure,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:F2}}" Grid.Row="8" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                <Button Content="Создать" Command="{Binding CreatingOverheadExpense}" Grid.Row="9" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Grid>
                        </mah:MetroTabItem>
                    </mah:MetroTabControl>
                </mah:MetroTabItem>
            </mah:MetroTabControl>
        </mah:MetroTabItem>
        <mah:MetroTabItem Header="Функции сверки">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Button Content="Запрос детальной сверки" Height="10" Width="190" VerticalAlignment="Center" HorizontalAlignment="Center" Command="{Binding StartCollation}"  Grid.Row="0" Grid.Column="0"/>
                <Button Content="Запрос сверки по диапозону" Height="10" Width="190" VerticalAlignment="Center" HorizontalAlignment="Center" Command="{Binding StartCollationRange}"  Grid.Row="0" Grid.Column="1"/>
                <Button Content="Запрос сверки поставщика по диапозону" Height="10" Width="300" VerticalAlignment="Center" HorizontalAlignment="Center" Command="{Binding StartCollationRangeProvider}"  Grid.Row="1" Grid.Column="0"/>

            </Grid>
        </mah:MetroTabItem>
    </mah:MetroTabControl>
</mah:MetroWindow>
