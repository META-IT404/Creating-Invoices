                                <DataGridTextColumn Header="Без наценки" MinWidth="300" Binding="{Binding TotalAmountBuy,StringFormat={}{0:F2}}"/>
                                <DataGridTextColumn Header="С наценкой" MinWidth="300" Binding="{Binding TotalAmountSell ,StringFormat={}{0:F2}}"/>
